{
  "daemon": true,
  "run": [
    {
      "when": "{{exists('app/backend/ports.py')}}",
      "method": "shell.run",
      "params": {
        "path": "app",
        "message": [
          "uv run --no-sync python -m backend.ports --free"
        ]
      }
    },
    {
      "method": "shell.run",
      "params": {
        "path": "app",
        "env": {
          "HF_HOME": "{{path.resolve(os.homedir(), '.cache', 'huggingface')}}"
        },
        "message": [
          "uv run --no-sync python -m backend._supervisor"
        ],
        "on": [
          {
            "event": "/Uvicorn running on /i",
            "done": true
          }
        ]
      }
    },
    {
      "method": "shell.run",
      "params": {
        "path": "app/frontend",
        "env": {
          "NO_COLOR": "1",
          "FORCE_COLOR": "0"
        },
        "message": [
          "npm run dev"
        ],
        "on": [
          {
            "event": "/(http:\\/\\/(?:localhost|127\\.0\\.0\\.1)[0-9:]*)/",
            "done": true
          }
        ]
      }
    },
    {
      "when": "{{input && input.event && Array.isArray(input.event) && input.event.length > 1}}",
      "method": "local.set",
      "params": {
        "url": "{{input.event[1]}}"
      }
    }
  ]
}
