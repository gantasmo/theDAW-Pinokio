{
  "run": [
    {
      "when": "{{platform === 'win32' && exists('app/native/vst-host/build.ps1')}}",
      "method": "shell.run",
      "params": {
        "path": "app",
        "message": [
          "where cmake >nul 2>&1 || conda install -y -c conda-forge cmake",
          "set \"CMAKE_GENERATOR=\" & powershell -NoProfile -ExecutionPolicy Bypass -File native\\vst-host\\build.ps1 -NoWerror"
        ]
      }
    }
  ]
}
